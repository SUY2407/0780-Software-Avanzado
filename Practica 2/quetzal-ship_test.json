	"item": [
		{
			"name": "1. Health Check",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test(\"Gateway responde\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.service).to.eql(\"api-gateway\");",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/health",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"health"
					]
				}
			},
			"response": []
		},
		{
			"name": "2. Crear Orden (Cálculo Exacto)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 201 Created\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"var jsonData = pm.response.json();",
							"pm.collectionVariables.set(\"valid_order_id\", jsonData.order_id);",
							"",
							"// VALIDACIÓN MATEMÁTICA",
							"// Peso: 10kg (Mayor que volumétrico 1.6kg)",
							"// Base: 10kg * 12 (INTERIOR) = 120",
							"// Servicio: 120 * 1.35 (EXPRESS) = 162",
							"// Recargos: +7 (Fragil) + 12.5 (Seguro 500*0.025) = 19.5",
							"// Subtotal: 162 + 19.5 = 181.5",
							"// Descuento: -10 (FIXED)",
							"// Total Esperado: 171.5",
							"",
							"pm.test(\"Cálculo de Precio Correcto (171.5)\", function () {",
							"    pm.expect(jsonData.total).to.eql(171.5);",
							"});",
							"",
							"pm.test(\"Desglose Correcto\", function () {",
							"    pm.expect(jsonData.breakdown.base_subtotal).to.eql(120);",
							"    pm.expect(jsonData.breakdown.service_subtotal).to.eql(162);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Idempotency-Key",
						"value": "key-math-test-01",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"origin_zone\": \"METRO\",\n  \"destination_zone\": \"INTERIOR\",\n  \"service_type\": \"EXPRESS\",\n  \"insurance_enabled\": true,\n  \"packages\": [\n    {\n      \"weight_kg\": 10,\n      \"height_cm\": 20,\n      \"width_cm\": 20,\n      \"length_cm\": 20,\n      \"fragile\": true,\n      \"declared_value_q\": 500\n    }\n  ],\n  \"discount\": {\n    \"type\": \"FIXED\",\n    \"value\": 10\n  }\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{base_url}}/v1/orders",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"v1",
						"orders"
					]
				}
			},
			"response": []
		},
		{
			"name": "3. Validar Idempotencia (Reenvío)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Debe retornar 201 o 200 (Misma respuesta)\", function () {",
							"    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
							"});",
							"",
							"var jsonData = pm.response.json();",
							"pm.test(\"Debe retornar el MISMO Order ID\", function () {",
							"    pm.expect(jsonData.order_id).to.eql(pm.collectionVariables.get(\"valid_order_id\"));",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Idempotency-Key",
