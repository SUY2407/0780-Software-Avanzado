					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 400\", function () {",
							"    pm.response.to.have.status(400);",
							"});",
							"",
							"pm.test(\"Mensaje de error coherente\", function () {",
							"    var jsonData = pm.response.json();",
							"    // NestJS suele devolver un array de mensajes o un mensaje string",
							"    pm.expect(JSON.stringify(jsonData)).to.include(\"service_type\");",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
